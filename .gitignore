# XcodeGen 生成物，不入库
Decal.xcodeproj/
Decal/Info.plist

# 构建产物
build/
DerivedData/
*.xcuserstate

# 系统
.DS_Store

# 本地验证素材与产物（体积大，脚本保留即可复现）
test/*.png
test/*.jpg
test/*.json
# 例外：CI 拿这三张跑深度推理，是回归素材不是中间产物
!test/bottle.png
!test/face.png
!test/building.png
cdp_*/
dist/

# 诊断出图
diag/*.png

# 深度模型是 CI 用 coremlcompiler 现编的（~50MB），不入库。
# 只保留占位目录里的 .keep，这样 XcodeGen 永远能解析到这个路径 ——
# 本地没有模型时构建照常成功，运行时 isAvailable = false，UI 会明说「模型没打进包」。
Model/*.mlmodelc/*
!Model/*.mlmodelc/.keep

# CI 产物下载目录
dl/
dl2/
depthmaps/
dm.zip
probe*.zip
probelogs*/
shots/
shots2/
dist2/

# 项目记忆
.workbuddy/
